    { name: "Bob", salary: 70000 }
];
Use map() to create an array of employee names.
Use filter() to get employees with a salary above 50000.
Use reduce() to calculate the total salary.
Use some() to check if anyone earns more than 60000.
Use every() to check if all employees earn more than 30000. */

const employees = [
    { name: "John", salary: 40000 },
    { name: "Alice", salary: 55000 },
    { name: "Bob", salary: 70000 }
];

 const name = employees.map(emp => emp.name);
 
 console.log(name);
 
 const empSalary = employees.filter(employee => employee.salary > 50000);
 
 console.log(empSalary);
 
 const totalSalary = employees.reduce((sum,employee)=>
 {
     return  sum + employee.salary;
 },0);
 
  console.log('totalSalary: ',totalSalary);
  
  const some = employees.some(employee => employee.salary > 60000);
  
  console.log('Some:',some);
  
  const every = employees.every(employee => employee.salary > 3000);
  
  console.log('Every:',every);
